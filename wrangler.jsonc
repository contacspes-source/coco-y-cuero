{
  "name": "coco-y-cuero",
  "compatibility_date": "2026-10-19",
  // El Worker solo atiende /api/catalogo, /fotos/* y /p/* (ver worker/manejador.ts);
  // todo lo demás lo sirve Cloudflare directo desde dist/ sin ejecutarlo.
  // Código fuente, migraciones y pruebas nunca llegan al servidor.
  "main": "worker/index.ts",
  // Cloudflare crea una vista previa por cada rama/PR con `wrangler preview`;
  // ese comando exige este bloque aunque vaya vacío. La configuración de
  // assets de abajo aplica igual a las vistas previas.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/fotos/*", "/p/*"]
  }
}
